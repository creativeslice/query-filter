{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "query-filter/sort",
	"title": "Sort",
	"category": "theme",
	"icon": "sort",
	"description": "Allows users to change the sort order when placed within a query loop block",
	"ancestor": [ "core/query" ],
	"usesContext": [ "queryId", "query" ],
	"supports": {
		"html": false,
		"className": true,
		"customClassName": true,
		"color": {
			"background": true,
			"text": true
		},
		"typography": {
			"fontSize": true,
			"textAlign": true,
			"lineHeight": true,
			"__experimentalFontFamily": true,
			"__experimentalFontWeight": true,
			"__experimentalFontStyle": true,
			"__experimentalTextTransform": true,
			"__experimentalTextDecoration": true,
			"__experimentalLetterSpacing": true,
			"__experimentalDefaultControls": {
				"fontSize": true
			}
		},
		"spacing": {
			"margin": true,
			"padding": true,
			"blockGap": true
		},
		"interactivity": {
			"clientNavigation": true
		}
	},
	"attributes": {
		"label": {
			"type": "string",
			"default": ""
		}
	},
	"textdomain": "query-filter",
	"editorScript": "file:./index.js",
	"viewScriptModule": "query-filter-taxonomy-view-script-module",
	"style": "query-filter-view",
	"render": "file:./render.php"
}
